  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "deploy": "npm run build && firebase deploy",
    "functions:build": "npm --prefix functions run build",
    "deploy:firestore:rules": "firebase deploy --only firestore:rules",
    "deploy:storage:rules": "firebase deploy --only storage",
    "deploy:functions": "firebase deploy --project bussiness-card-bda7f --only functions",
    "admin:set-claim": "PROJECT_ID=bussiness-card-bda7f GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json node admin-scripts/setAdminClaim.cjs",
    "admin:cleanup-legacy-claim": "PROJECT_ID=bussiness-card-bda7f GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json node admin-scripts/setAdminClaim.cjs cleanup-legacy",
    "admin:revoke-claim": "PROJECT_ID=bussiness-card-bda7f GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json node admin-scripts/setAdminClaim.cjs revoke",
    "test:firestore:rules": "firebase emulators:exec --only firestore \"npm test -- --watchAll=false src/firestore/rules/firestore-rules.test.ts\"",
    "test:storage:rules": "firebase emulators:exec --only firestore,storage \"npm test -- --watchAll=false src/storage/rules/storage-rules.test.ts\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-react": "^5.0.0",
    "babel-jest": "^30.0.0",
    "firebase-tools": "^15.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "vite": "^7.0.0",
    "vite-plugin-svgr": "^4.3.0"
  }
}
